{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_seo_content_generator",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_post": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateSeoBlogPost"
          },
          "then": "end",
          "x-base44": {
            "title": "Generate SEO blog post draft",
            "description": "Researches trending topics and writes a new draft for review"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Autonomously researches trending coffee topics and generates a new SEO blog post draft every Monday at 9am Central. Drafts require human review before publishing.",
  "name": "Weekly SEO Content Generator"
}