{
  "name": "PointsActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user this activity belongs to"
    },
    "type": {
      "type": "string",
      "enum": [
        "earn",
        "redeem"
      ],
      "description": "Whether points were earned or redeemed"
    },
    "points": {
      "type": "number",
      "description": "Number of points involved (always positive)"
    },
    "label": {
      "type": "string",
      "description": "Human-readable reason, e.g. 'Order placed', 'Redeemed 10% Off'"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this activity entry"
    }
  },
  "required": [
    "user_id",
    "type",
    "points",
    "label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}