{
  "name": "Review",
  "type": "object",
  "properties": {
    "reviewer_name": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "review_date": {
      "type": "string"
    },
    "product_handle": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    }
  },
  "required": [
    "body",
    "rating",
    "reviewer_name"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}