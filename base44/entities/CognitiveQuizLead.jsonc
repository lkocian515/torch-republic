{
  "name": "CognitiveQuizLead",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Captured email address"
    },
    "answers": {
      "type": "object",
      "description": "Quiz answers as JSON"
    },
    "result_blend": {
      "type": "string",
      "enum": [
        "GlowMind",
        "MoonCap"
      ],
      "description": "Recommended blend"
    },
    "result_profile": {
      "type": "string",
      "description": "Cognitive profile label"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this quiz lead"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}