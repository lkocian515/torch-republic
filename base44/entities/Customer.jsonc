{
  "name": "Customer",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Legacy Shopify customer ID \u2014 preserved for historical compatibility"
    },
    "first_name": {
      "type": "string",
      "description": "Customer first name"
    },
    "last_name": {
      "type": "string",
      "description": "Customer last name"
    },
    "email": {
      "type": "string",
      "description": "Customer email address"
    },
    "accepts_email_marketing": {
      "type": "boolean",
      "default": false,
      "description": "Whether customer accepts email marketing"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Total amount spent by customer"
    },
    "total_orders": {
      "type": "number",
      "default": 0,
      "description": "Number of orders placed"
    },
    "phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "city": {
      "type": "string",
      "description": "Customer city"
    },
    "province_code": {
      "type": "string",
      "description": "Customer state/province code"
    },
    "country_code": {
      "type": "string",
      "description": "Customer country code"
    },
    "shipping_address": {
      "type": "string",
      "description": "Default shipping street address"
    },
    "shipping_city": {
      "type": "string",
      "description": "Default shipping city"
    },
    "shipping_state": {
      "type": "string",
      "description": "Default shipping state/province"
    },
    "shipping_postal_code": {
      "type": "string",
      "description": "Default shipping postal code"
    },
    "shipping_country": {
      "type": "string",
      "description": "Default shipping country"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for recurring/linked payments"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this customer"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}