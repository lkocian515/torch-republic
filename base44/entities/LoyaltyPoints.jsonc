{
  "name": "LoyaltyPoints",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user this record belongs to"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Current points balance"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "description": "Total points ever earned"
    },
    "redeemed_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of discount codes already redeemed"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "id": {
          "$exists": true
        }
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}