{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product name"
    },
    "shopify_handle": {
      "type": "string",
      "description": "Shopify product handle for direct linking"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Product price in USD"
    },
    "compare_at_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "image_url": {
      "type": "string",
      "description": "Main product image URL"
    },
    "image_url_2": {
      "type": "string",
      "description": "Secondary product image URL"
    },
    "collection": {
      "type": "string",
      "enum": [
        "best-sellers",
        "on-sale",
        "liberty-flame",
        "patriotic-pride",
        "freedom-isnt-free",
        "we-the-people",
        "faith-over-fear",
        "christ-is-king",
        "god-family-country",
        "american-heroes",
        "founders"
      ],
      "description": "Which collection this product belongs to"
    },
    "on_sale": {
      "type": "boolean",
      "default": false,
      "description": "Whether this product is in the on-sale collection"
    },
    "category": {
      "type": "string",
      "enum": [
        "t-shirts",
        "hoodies-sweatshirts",
        "tanks",
        "hats",
        "magnets",
        "stickers",
        "jewelry",
        "mugs-tumblers",
        "candles",
        "flags",
        "bobbleheads",
        "coffee",
        "tea",
        "accessories",
        "home-decor"
      ],
      "description": "Product category"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available sizes"
    },
    "rating": {
      "type": "number",
      "description": "Average rating"
    },
    "review_count": {
      "type": "number",
      "description": "Number of reviews"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a featured product"
    },
    "best_seller_rank": {
      "type": "number",
      "description": "Position in best-sellers collection (1 = top seller). Null if not a best seller."
    },
    "in_stock": {
      "type": "boolean",
      "default": true,
      "description": "Whether the product is in stock"
    }
  },
  "required": [
    "title",
    "price"
  ]
}