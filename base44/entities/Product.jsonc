{
  "name": "Product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Product name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug for the product page (e.g. glowmind-clarity-blend)"
    },
    "shopify_handle": {
      "type": "string",
      "description": "Legacy Shopify product handle \u2014 preserved for historical compatibility"
    },
    "sku": {
      "type": "string",
      "description": "Internal product SKU"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Product price in USD"
    },
    "compare_at_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "image_url": {
      "type": "string",
      "description": "Main product image URL"
    },
    "image_url_2": {
      "type": "string",
      "description": "Secondary product image URL"
    },
    "additional_images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional product gallery image URLs"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "instant-coffee",
        "mushroom-coffee",
        "matcha",
        "bundle",
        "subscription"
      ],
      "description": "High-level product type for the new Base44 storefront"
    },
    "collection": {
      "type": "string",
      "enum": [
        "best-sellers",
        "on-sale",
        "founders-series",
        "liberty-icons",
        "commanders-series",
        "women-of-the-republic",
        "liberty-flame",
        "patriotic-pride",
        "freedom-isnt-free",
        "we-the-people",
        "faith-over-fear",
        "christ-is-king",
        "god-family-country",
        "american-heroes",
        "founders",
        "classic-coffee",
        "mushroom-coffee",
        "matcha",
        "featured",
        "bundles"
      ],
      "description": "Which collection this product belongs to (legacy apparel values preserved)"
    },
    "on_sale": {
      "type": "boolean",
      "default": false,
      "description": "Whether this product is in the on-sale collection"
    },
    "category": {
      "type": "string",
      "enum": [
        "t-shirts",
        "hoodies-sweatshirts",
        "tanks",
        "hats",
        "magnets",
        "stickers",
        "jewelry",
        "mugs-tumblers",
        "candles",
        "flags",
        "bobbleheads",
        "coffee",
        "tea",
        "accessories",
        "home-decor",
        "classic-coffee",
        "mushroom-coffee",
        "matcha"
      ],
      "description": "Product category (legacy apparel values preserved)"
    },
    "sizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available sizes (legacy apparel field \u2014 preserved)"
    },
    "servings": {
      "type": "number",
      "description": "Number of servings per container"
    },
    "ingredients": {
      "type": "string",
      "description": "Full ingredient list"
    },
    "mushroom_species": {
      "type": "string",
      "description": "Functional mushroom species (e.g. Lion's Mane, Chaga). Empty for non-mushroom products."
    },
    "mushroom_amount_per_serving": {
      "type": "string",
      "description": "Mushroom extract amount per serving (e.g. 500mg)"
    },
    "caffeine_info": {
      "type": "string",
      "description": "Caffeine level or amount (e.g. medium, ~95mg)"
    },
    "flavor": {
      "type": "string",
      "description": "Primary flavor profile / tasting notes"
    },
    "rating": {
      "type": "number",
      "description": "Average rating"
    },
    "review_count": {
      "type": "number",
      "description": "Number of reviews"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a featured product"
    },
    "best_seller_rank": {
      "type": "number",
      "description": "Position in best-sellers collection (1 = top seller). Null if not a best seller."
    },
    "in_stock": {
      "type": "boolean",
      "default": true,
      "description": "Whether the product is in stock"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active",
      "description": "Lifecycle status. Legacy apparel products use inactive/archived instead of being deleted."
    },
    "seo_title": {
      "type": "string",
      "description": "SEO page title"
    },
    "seo_description": {
      "type": "string",
      "description": "SEO meta description"
    },
    "roastify_product_id": {
      "type": "string",
      "description": "Roastify product ID \u2014 optional until the Roastify integration is configured"
    },
    "roastify_variant_id": {
      "type": "string",
      "description": "Roastify variant ID \u2014 optional until the Roastify integration is configured"
    },
    "roastify_sku": {
      "type": "string",
      "description": "Roastify SKU \u2014 optional until the Roastify integration is configured"
    },
    "shipping_metadata": {
      "type": "object",
      "description": "Optional fulfillment metadata (weight, dimensions, shipping class)"
    }
  },
  "required": [
    "title",
    "price"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}